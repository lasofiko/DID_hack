<?xml version="1.0"?>
<package format="3">
  <name>did_robot</name><version>0.1.0</version>
  <description>Deterministic EASY TurtleBot3 agent and optional mock judge</description>
  <maintainer email="did-hack@example.invalid">DID Hack team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend><exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>tf2_msgs</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_map_server</exec_depend><exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <export><build_type>ament_python</build_type></export>

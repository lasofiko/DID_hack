# Copy to .env and insert a NEW key locally. Never commit .env.
DID_LLM_API_KEY=
DID_LLM_MODEL=deepseek-v4.1-flash
# Assumed Chat Completions path: confirm with MAI if the server returns 404.
DID_LLM_ENDPOINT=https://api-ai.mai.ru/v1/chat/completions
DID_LLM_TIMEOUT=5
DID_LLM_MAX_TOKENS=512
# If MAI rejects response_format, set false; local JSON validation still applies.
DID_LLM_JSON_MODE=true
# If MAI rejects thinking, set omit. Prefer disabled for short robot subgoals.
DID_LLM_THINKING=disabled
